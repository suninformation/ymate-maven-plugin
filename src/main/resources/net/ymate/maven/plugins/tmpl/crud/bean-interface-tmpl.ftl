<#setting number_format="#">
<#macro buildGetAndSet p>
    <#if p.config?? && p.config.query?? && p.config.query.enabled><#if (p.description??)>
        /**
         * ${p.description}
         */</#if>
        <#if p.config.query.validation?? && p.config.query.validation.dateTime?? && p.config.query.validation.dateTime.enabled>
            net.ymate.platform.validation.validate.DateTimeValue get${p.name?cap_first}();

        <#else>
            ${p.type} get${p.name?cap_first}();

        </#if>
    </#if>
</#macro>
