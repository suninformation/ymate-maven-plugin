package ${app.packageName}.bean;

import java.io.Serializable;

/**
 * <#if api.description?? && (api.description?length > 0)>${api.description}</#if>
 *
 * I${prefix}${api.name?cap_first}Bean generated By CrudMojo on ${.now?string("yyyy/MM/dd HH:mm")}
 *
 * @author ${app.author!"YMP (https://www.ymate.net/)"}
 * @since ${app.version!"1.0.0"}
 */
public interface I${prefix}${api.name?cap_first}Bean extends Serializable {

<#if multiPrimaryKey><#list primaryFields as p>
    <@buildGetAndSet p/>
</#list><#elseif primaryKey??><@buildGetAndSet primaryKey/></#if><#list normalFields as p><@buildGetAndSet p/></#list>
}