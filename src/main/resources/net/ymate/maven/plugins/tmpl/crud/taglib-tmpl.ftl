<#setting number_format="#">
<#macro buildField p>
    <#if p.config?? && p.config.query?? && p.config.query.enabled><#if (p.description??)>
        /**
        * ${p.description}
        */</#if>
        <#if p.config.query.validation?? && p.config.query.validation.dateTime?? && p.config.query.validation.dateTime.enabled>
            private String ${p.name}Str;

        <#else>
            private ${p.type} ${p.name};

        </#if>
    </#if>
</#macro>
<#macro buildGetAndSet p>
    <#if p.config?? && p.config.query?? && p.config.query.enabled><#if p.config.query.validation?? && p.config.query.validation.dateTime?? && p.config.query.validation.dateTime.enabled>
        @Override
        public net.ymate.platform.validation.validate.DateTimeValue get${p.name?cap_first}() {
            return net.ymate.platform.validation.validate.DateTimeValue.parse(${p.name}Str, DateTimeUtils.YYYY_MM_DD, false);
        }

        public String get${p.name?cap_first}Str() {
            return ${p.name}Str;
        }

        public void set${p.name?cap_first}Str(String ${p.name}Str) {
            this.${p.name}Str = ${p.name}Str;
        }

    <#else>
        @Override
        public ${p.type} get${p.name?cap_first}() {
            return ${p.name};
        }

        public void set${p.name?cap_first}(${p.type} ${p.name}) {
            this.${p.name} = ${p.name};
        }

    </#if></#if>
</#macro>
